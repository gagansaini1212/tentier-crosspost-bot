# Required: Bot Token & Your Telegram User ID (get via /myid)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
ADMIN_USER_IDS=your_numeric_telegram_user_id

# Optional: Telegram Channel (bot must be Admin in channel)
TELEGRAM_CHANNEL_ID=

# Optional: Discord Webhook
DISCORD_WEBHOOK_URL=

# Optional: X (Twitter) API v1.1 + v2
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional: Bluesky
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Optional: Mastodon
MASTODON_BASE_URL=
MASTODON_ACCESS_TOKEN=

# Optional: LinkedIn
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# Optional: Facebook Page & Instagram Business
FB_PAGE_ID=
IG_USER_ID=
META_ACCESS_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
